# Optional: copy to .env to override the defaults in docker-compose.yml (e.g. to use a real LLM).
# The stack runs without .env. Never commit real secrets.

# LLM: "fake" runs the deterministic scripted model (no key needed, used by tests and key-less demo);
# "anthropic" uses the Claude API through the official Go SDK.
LLM_PROVIDER=fake
LLM_MODEL=claude-opus-5
ANTHROPIC_API_KEY=

# Backend
HTTP_ADDR=:8080
LLM_TIMEOUT=45s

# Demo users (synthetic). Tokens map to roles in the mock auth service.
DEMO_INTERN_TOKEN=intern-demo-token
DEMO_MENTOR_TOKEN=mentor-demo-token
